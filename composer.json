{
    "name": "tueen/telegram",
    "description": "The Royal Telegram Bot API Client — Strictly typed, forward-compatible, and crafted for modern PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": ["telegram", "telegram-bot", "telegram-bot-api", "bot-api", "bot", "tueen", "sdk", "api-client"],
    "authors": [
        {
            "name": "Hadi Akbarzadeh",
            "homepage": "https://elatel.ir",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tueen\\Telegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tueen\\Telegram\\Tests\\": "tests/",
            "Tueen\\Telegram\\Generator\\": "tools/generator/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "generate": [
            "@php bin/generate.php",
            "@composer dump-autoload",
            "@php tools/validate.php"
        ],
        "update-api": [
            "@php bin/update_spec.php",
            "@composer generate"
        ],
        "test": "phpunit",
        "lint": "@php tools/validate.php"
    },
    "scripts-descriptions": {
        "generate": "Regenerate all Telegram Bot API Types, Methods, and Mixin contracts from schema",
        "update-api": "Fetch latest Telegram Bot API specification online and regenerate all classes",
        "test": "Run the PHPUnit test suite",
        "lint": "Fast in-process syntax and token validation of all classes"
    }
}

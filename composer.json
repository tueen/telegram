{
    "name": "tueen/telegram",
    "description": "The Royal Telegram Bot API Client for PHP 8.4 & 8.5 - fast, elegant, and ultra-modern",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tueen Team",
            "email": "dev@tueen.org"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tueen\\Telegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tueen\\Telegram\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
